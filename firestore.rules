rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "adminsafeheaven09@gmail.com"
      );
    }

    // INCIDENT REPORTS COLLECTION
    match /incidentReports/{reportId} {
      // Public & authenticated users can read community incident reports
      allow read: if true;
      
      // Community users can create incident reports with valid payload structure
      allow create: if request.resource.data.category is string
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.severity is string;
      
      // Updates: Authorized admins can moderate status/deletion; community users can update votes without tampering core details
      allow update: if isAdmin() || (
        request.resource.data.category == resource.data.category &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.location == resource.data.location
      );
      
      // Only authenticated admin users can delete incident reports
      allow delete: if isAdmin();
    }

    // SAFETY ZONES COLLECTION (Computed system aggregate data)
    match /safetyZones/{zoneId} {
      allow read: if true;
      allow write: if false; // Admin / Cloud Functions write only
    }

    // ACTIVE TRIPS COLLECTION
    match /activeTrips/{tripId} {
      // Accessible by trip owner OR explicitly accepted trusted contacts listed in sharedWithContactIds
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.sharedWithContactIds
      );
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // SOS EVENTS COLLECTION
    match /sosEvents/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.notifiedContactIds
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.notifiedContactIds
      );
    }

    // SAFE HAVENS COLLECTION (Verified Partner Locations)
    match /safeHavens/{havenId} {
      allow read: if true;
      allow write: if false; // System admin only
    }
  }
}
