# SafeRoute Environment Variables Configuration

# ----------------------------------------------------
# SERVER-SIDE CONFIGURATION (Render Web Service)
# ----------------------------------------------------
PORT=3000
NODE_ENV=production

# Gemini AI API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Server Secrets (Server-side only)
# OTP_PROVIDER_API_KEY=
# OTP_PROVIDER_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_PHONE_NUMBER=

# ----------------------------------------------------
# CLIENT-SIDE CONFIGURATION (Exposed to React Frontend)
# ----------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
